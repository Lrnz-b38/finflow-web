PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_make_it_strong_and_random
NODE_ENV=production
OPENAI_API_KEY=your_openai_api_key_here

# For Railway deployment:
# 1. Set these variables in Railway project settings
# 2. PORT can be left empty (Railway will set it automatically)
# 3. JWT_SECRET: Generate a strong random string (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 4. MONGODB_URI: Use MongoDB Atlas connection string

